# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-from-aistudio.google.com
GOOGLE_GENAI_USE_VERTEXAI=false

# ── Google Cloud ───────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=apt-diode-498606-j6
GOOGLE_CLOUD_LOCATION=us-central1

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-min-32-chars

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite for hackathon/local. Use PostgreSQL URL for production.
DATABASE_URL=sqlite:///./redboard.db

# ── File storage ───────────────────────────────────────────────────────────────
# Leave as defaults for local. Override in Cloud Run env vars if needed.
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

# ── Email via Resend (resend.com — free 3000/month) ────────────────────────────
# Leave blank to print emails to terminal in dev mode
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=Redboard

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for local dev.
# For production: https://redboard.dev,https://www.redboard.dev
ALLOWED_ORIGINS=*
